{
  "name": "vortex-browser",
  "version": "1.3.13",
  "description": "Vortex - Modern, Fast, Minimalist & Privacy-Focused Web Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "node publish-release.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vortexbrowser/vortex-browser.git"
  },
  "build": {
    "appId": "com.vortex.browser",
    "productName": "Vortex Browser",
    "copyright": "Copyright © 2026 Vortex Team",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "settings.html",
      "settings.css",
      "settings.js",
      "extensions.html",
      "package.json",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vortexbrowser",
        "repo": "vortex-browser",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vortex Browser",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": true
    }
  },
  "keywords": [
    "browser",
    "vortex",
    "privacy",
    "minimalist",
    "developer"
  ],
  "author": "Vortex Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "electron-updater": "^6.8.9"
  }
}
